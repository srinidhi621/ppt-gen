  "color_roles": {
    "accent_1":       "primary brand / headings / key shapes",
    "accent_2":       "highlight / callout / risk indicator",
    "accent_3":       "warning / attention / secondary highlight",
    "accent_4":       "tertiary accent / charts / diagrams",
    "accent_5":       "muted fill / dividers / secondary backgrounds",
    "accent_6":       "subtle text / borders / deemphasized elements",
    "bg_primary":     "primary slide background (light theme)",
    "bg_dark":        "primary slide background (dark theme)",
    "text_primary":   "main body text on light backgrounds",
    "text_secondary": "subtitle / caption / metadata text",
    "text_on_dark":   "text on dark backgrounds",
    "success":        "positive indicator / on-track status",
    "warning":        "caution indicator / at-risk status",
    "risk":           "negative indicator / blocked status",
    "hyperlink":      "hyperlink text"
  },

  "accent_policy": {
    "primary_role": "accent_1",
    "secondary_role": "accent_2",
    "max_accent_roles_per_slide": 2,
    "hero_treatment_accents": ["accent_1"]
