{
  "version": "1.0",
  "allowed_primitives": [
    "table",
    "chart",
    "shape_cluster",
    "icon_label_grid",
    "smartart_like_flow",
    "matrix_grid",
    "timeline_stepper",
    "text_callout"
  ],
  "max_primitives_per_slide": 3,
  "declutter_rules": [
    "limit_primitive_families_per_slide",
    "avoid_decorative_elements_without_message_support",
    "preserve_whitespace_buffers",
    "use_single_visual_focal_point"
  ],
  "style_tokens": {
    "headline_role": "h1",
    "body_role": "body",
    "caption_role": "caption",
    "accent_role": "accent"
  }
}
