{
  "schema": "component_catalog_v1",
  "version": "1.0.0",
  "components": [
    {
      "component_id": "title_slide",
      "display_name": "TitleSlide",
      "purpose": "Opening slide with title and subtitle",
      "use_when": ["deck opening", "major section opening"],
      "min_size": {"w": 7.0, "h": 2.5},
      "preferred_size": {"w": 11.5, "h": 4.5},
      "max_items": {"subtitle_lines": 2}
    },
    {
      "component_id": "section_break",
      "display_name": "SectionBreak",
      "purpose": "Transition slide with strong visual anchor",
      "use_when": ["new narrative chapter", "divider slide"],
      "min_size": {"w": 8.0, "h": 2.5},
      "preferred_size": {"w": 12.0, "h": 5.0},
      "max_items": {"title_words": 10}
    },
    {
      "component_id": "content_block",
      "display_name": "ContentBlock",
      "purpose": "Primary text content panel",
      "use_when": ["explanatory text", "short bullet lists"],
      "min_size": {"w": 4.5, "h": 2.5},
      "preferred_size": {"w": 6.5, "h": 4.0},
      "max_items": {"bullets": 6}
    },
    {
      "component_id": "text_with_image",
      "display_name": "TextWithImage",
      "purpose": "Split narrative + supporting visual",
      "use_when": ["concept + example", "problem + context"],
      "min_size": {"w": 8.0, "h": 4.0},
      "preferred_size": {"w": 12.0, "h": 5.5},
      "max_items": {"bullets": 5}
    },
    {
      "component_id": "metric_cards",
      "display_name": "MetricCards",
      "purpose": "Highlight key numbers",
      "use_when": ["KPI slides", "outcomes summary"],
      "min_size": {"w": 8.5, "h": 2.5},
      "preferred_size": {"w": 12.0, "h": 4.0},
      "max_items": {"cards": 4}
    },
    {
      "component_id": "bento_grid",
      "display_name": "BentoGrid",
      "purpose": "Structured multi-card storytelling",
      "use_when": ["feature clusters", "multi-theme summaries"],
      "min_size": {"w": 9.5, "h": 4.5},
      "preferred_size": {"w": 12.2, "h": 6.0},
      "max_items": {"cells": 6}
    },
    {
      "component_id": "icon_grid",
      "display_name": "IconGrid",
      "purpose": "Concept overview with icon+label cells",
      "use_when": ["capability matrix", "service overviews"],
      "min_size": {"w": 8.5, "h": 4.0},
      "preferred_size": {"w": 12.0, "h": 5.8},
      "max_items": {"cells": 8}
    },
    {
      "component_id": "timeline",
      "display_name": "Timeline",
      "purpose": "Chronological milestone sequence",
      "use_when": ["roadmaps", "phase plans"],
      "min_size": {"w": 9.0, "h": 3.0},
      "preferred_size": {"w": 12.0, "h": 5.0},
      "max_items": {"events": 8}
    },
    {
      "component_id": "process_flow",
      "display_name": "ProcessFlow",
      "purpose": "Connected step-by-step flow",
      "use_when": ["operating model", "workflow explanation"],
      "min_size": {"w": 8.5, "h": 3.0},
      "preferred_size": {"w": 12.0, "h": 5.0},
      "max_items": {"steps": 7}
    },
    {
      "component_id": "comparison_columns",
      "display_name": "ComparisonColumns",
      "purpose": "Side-by-side tradeoff view",
      "use_when": ["option comparison", "before vs after"],
      "min_size": {"w": 8.0, "h": 3.5},
      "preferred_size": {"w": 12.0, "h": 5.5},
      "max_items": {"columns": 3}
    },
    {
      "component_id": "architecture_diagram",
      "display_name": "ArchitectureDiagram",
      "purpose": "Node-edge system visualization",
      "use_when": ["system architecture", "integration maps"],
      "min_size": {"w": 9.0, "h": 4.0},
      "preferred_size": {"w": 12.0, "h": 6.0},
      "max_items": {"nodes": 10, "edges": 14}
    },
    {
      "component_id": "data_table",
      "display_name": "DataTable",
      "purpose": "Structured tabular evidence",
      "use_when": ["benchmark table", "controls and status"],
      "min_size": {"w": 8.0, "h": 3.5},
      "preferred_size": {"w": 12.0, "h": 5.8},
      "max_items": {"rows": 8, "columns": 5}
    }
  ],
  "planner_hints": {
    "min_distinct_component_types_per_15_slides": 5,
    "max_same_component_streak": 2,
    "prefer_visual_components_for_cue_rich_sections": true
  }
}
